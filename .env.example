# Contact form email delivery (https://resend.com)
RESEND_API_KEY=
# Required verified sender, for example: "Eclar Khalid <contact@eclarkhalid.com>"
CONTACT_FROM=

# Lumen, the AI guide (Claude Sonnet 5.5 via https://console.anthropic.com).
# Server only. Without a key the panel shows the contact form instead.
ANTHROPIC_API_KEY=
# Daily spend cap in US dollars (defaults to 2). Lumen rests until the next UTC day when reached.
AI_DAILY_BUDGET_USD=2

# Optional webmaster verification tokens. Leave blank to omit their meta tags.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
